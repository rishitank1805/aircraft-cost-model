# Copy to .env and adjust as needed. All settings are optional.

# Override the project root (defaults to the directory containing pyproject.toml).
# ACM_PROJECT_ROOT=/path/to/open-aircraft-cost-model

# Override the SQLite database file (default: <root>/database/aircraft_costs.db).
# ACM_DATABASE_PATH=database/aircraft_costs.db

# Public airport dataset URL (default: OurAirports airports.csv).
# ACM_AIRPORTS_URL=https://ourairports.com/data/airports.csv

# HTTP timeouts in seconds.
# ACM_HTTP_CONNECT_TIMEOUT=10
# ACM_HTTP_READ_TIMEOUT=120

# Logging level: DEBUG, INFO, WARNING, ERROR.
# ACM_LOG_LEVEL=INFO

# Optional EIA API v2 key (free registration: https://www.eia.gov/opendata/register.php).
# Not required: fuel prices are ingested from EIA's public XLS download by default.
# ACM_EIA_API_KEY=
